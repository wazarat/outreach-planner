# ---- Neon Postgres (required) ----
# Connection string from your Neon project (use the pooled connection string).
# Get one at https://console.neon.tech — Project → Connection Details.
DATABASE_URL=postgresql://user:password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=require

# After setting DATABASE_URL, create the tables with: npm run bootstrap:db

# ---- Instantly.ai (required for the Leads module) ----
INSTANTLY_API_KEY=your-instantly-v2-api-key
