# ---- Google Sheets (required) ----
# Service account email from your Google Cloud service account JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Private key from the same JSON key. Keep the quotes and the \n escapes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Default spreadsheet used by all modules (the long ID from the sheet URL)
SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# Optional per-module overrides if you want separate spreadsheets per module.
# Each module falls back to SHEETS_SPREADSHEET_ID when unset.
# COLD_SPREADSHEET_ID=
# WARM_SPREADSHEET_ID=
# CONTENT_SPREADSHEET_ID=
# OFFERS_SPREADSHEET_ID=
# LEADS_SPREADSHEET_ID=
# P1_PEOPLE_SPREADSHEET_ID=
# P1_POINTS_SPREADSHEET_ID=
# P2_MOVES_SPREADSHEET_ID=
# P2_SAYNO_SPREADSHEET_ID=
# P2_FAMOUS_SPREADSHEET_ID=
# P2_SEVEN_SPREADSHEET_ID=
# P3_SIGNALS_SPREADSHEET_ID=
# P3_POSITIONING_SPREADSHEET_ID=
# P4_CHAMPIONS_SPREADSHEET_ID=

# Optional tab-name overrides (defaults: "Cold Outreach", "Warm Outreach",
# "Content", "Offers", "Leads", plus the principle tabs "P1 Valued People",
# "P1 Points", "P2 Market Moves", "P2 Say No", "P2 Famous Notes", "P2 7-11-4",
# "P3 Signals", "P3 Positioning", "P4 Champions")
# COLD_SHEET_TAB=
# WARM_SHEET_TAB=
# CONTENT_SHEET_TAB=
# OFFERS_SHEET_TAB=
# LEADS_SHEET_TAB=
# P1_PEOPLE_SHEET_TAB=
# P1_POINTS_SHEET_TAB=
# P2_MOVES_SHEET_TAB=
# P2_SAYNO_SHEET_TAB=
# P2_FAMOUS_SHEET_TAB=
# P2_SEVEN_SHEET_TAB=
# P3_SIGNALS_SHEET_TAB=
# P3_POSITIONING_SHEET_TAB=
# P4_CHAMPIONS_SHEET_TAB=

# ---- Instantly.ai (required for the Leads module) ----
INSTANTLY_API_KEY=your-instantly-v2-api-key
